# Copy to .env and fill in. Every setting in app/config.py can be set here.

# --- Answering LLM -----------------------------------------------------------
# Primary provider: gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional backup, used only when the primary fails (quota, outage, bad response)
# LLM_BACKUP_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# For an OpenAI-compatible service other than OpenAI, set its base URL:
# OPENAI_BASE_URL=https://example.com/v1

# Anthropic (only if LLM_PROVIDER or LLM_BACKUP_PROVIDER is anthropic)
# ANTHROPIC_API_KEY=

# --- OCR ---------------------------------------------------------------------
# Windows: path to tesseract.exe if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR engine for scanned / broken pages: tesseract | gemini | claude | docai
# gemini, claude and docai send page images to an outside service; review before using on personal data.
OCR_ENGINE=tesseract
TESSERACT_LANG=urd+eng

# Google Document AI (only when OCR_ENGINE=docai or for the OCR comparison)
# DOCAI_PROJECT_ID=
# DOCAI_LOCATION=us
# DOCAI_PROCESSOR_ID=

# --- Retrieval ---------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
FINAL_TOP_K=6
