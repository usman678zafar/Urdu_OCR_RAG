# Copy to .env and fill in. Every setting in app/config.py can be set here.

# --- Answering LLM -----------------------------------------------------------
# Primary provider: gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Model for Gemini OCR (defaults to GEMINI_MODEL); a fast "lite" model reads pages well
# GEMINI_OCR_MODEL=

# Optional backup, used only when the primary fails (quota, outage, bad response)
# LLM_BACKUP_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# For an OpenAI-compatible service other than OpenAI, set its base URL:
# OPENAI_BASE_URL=https://example.com/v1

# Anthropic (only if LLM_PROVIDER or LLM_BACKUP_PROVIDER is anthropic)
# ANTHROPIC_API_KEY=

# --- OCR ---------------------------------------------------------------------
# Windows: path to tesseract.exe if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR engine for scanned / broken pages: tesseract | gemini | claude | docai
# gemini, claude and docai send page images to an outside service; review before using on personal data.
OCR_ENGINE=tesseract
TESSERACT_LANG=urd+eng

# When Tesseract garbles a page (mixed Urdu/Latin noise), OCR it again with the fallback.
# Set OCR_FALLBACK_ENABLED=false to never send page images out for a fallback.
OCR_FALLBACK_ENABLED=true
OCR_FALLBACK_ENGINE=gemini
# OCR_MIN_URDU_SHARE=0.85
# Pages OCR'd at once; lowered automatically on rate limits
OCR_CONCURRENCY=4
# OCR_MAX_ATTEMPTS=4
# OCR_RETRY_BASE_DELAY=2.0

# Google Document AI (only when OCR_ENGINE=docai or for the OCR comparison)
# DOCAI_PROJECT_ID=
# DOCAI_LOCATION=us
# DOCAI_PROCESSOR_ID=

# --- Retrieval ---------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
FINAL_TOP_K=6
# Below this top score, answer "not found" without calling the LLM (reranker score 0-1,
# or vector similarity 0-1 when the reranker is off). Unset = always ask the LLM.
# MIN_RELEVANCE_SCORE=
# Return per-step timings in /ask responses
# DEBUG_TIMINGS=true
