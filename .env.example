# Copy to .env and fill in. Every setting in app/config.py can be set here.

# Required for answers (and for the Claude vision OCR engine)
ANTHROPIC_API_KEY=

# Windows: path to tesseract.exe if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR engine for scanned / broken pages: tesseract | claude | docai
# claude and docai send page images to an outside service; review before using on personal data.
OCR_ENGINE=tesseract
TESSERACT_LANG=urd+eng

# Google Document AI (only when OCR_ENGINE=docai or for the OCR comparison)
# DOCAI_PROJECT_ID=
# DOCAI_LOCATION=us
# DOCAI_PROCESSOR_ID=

# Retrieval
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
FINAL_TOP_K=6

# Generation
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
